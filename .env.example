SN_INSTANCE_URL=https://devXXXXX.service-now.com
SN_USERNAME=admin
SN_PASSWORD=
SN_TENANT_USERNAME=admin
SN_PRODUCTION_MODE=1

FORWARD_BASE_URL=https://fwd.app/api
NETWORK_ID=235937
FORWARD_USERNAME=
FORWARD_PASSWORD=
FORWARD_TOKEN_FILE=

# Preferred for production ServiceNow installs.
# Create a ServiceNow Basic Auth Profile for Forward API credentials,
# then bind users with this sys_id instead of storing credentials in custom tables.
SN_FORWARD_AUTH_PROFILE_SYS_ID=

# Optional browser proof inputs.
SN_VERIFY_SRC_IP=192.168.100.57
SN_VERIFY_DST_IP=203.0.113.10
SN_VERIFY_CHANGE_NUMBER=
SN_VERIFY_EXPECTED_OUTCOME=blocked

# Optional CMDB side effect for Forward verifier.
PUSH_CMDB=0
